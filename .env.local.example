NEXT_PUBLIC_SUPABASE_URL=https://jxdzwtnkchkzllaedvbg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Ciqipc7xMKres9p88JnhuA_mTA8IO_P

# Used to build absolute links in auth emails (signup confirmation). Must
# match the URL Supabase is told to allow under Authentication > URL
# Configuration > Redirect URLs, e.g. https://staging.wrenchy.app/auth/callback
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only — never prefix with NEXT_PUBLIC_. Bypasses every RLS policy;
# used only by src/lib/supabase-admin.ts for payment/payout/ledger writes.
# Supabase dashboard -> Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Peach Payments (sandbox). Dashboard -> API keys.
PEACH_CLIENT_ID=
PEACH_CLIENT_SECRET=
PEACH_MERCHANT_ID=
PEACH_ENTITY_ID=
# Defaults below point at Peach's sandbox — override for production. Not
# independently confirmed (see src/lib/peach.ts) — check against Peach's own
# docs/dashboard before trusting these hostnames.
PEACH_AUTH_URL=https://sandbox-dashboard.peachpayments.com/api/oauth/token
PEACH_API_URL=https://testsecure.peachpayments.com
# The secret token Peach signs webhooks with — set the same webhook URLs
# (see README) in the Peach dashboard and copy the signing secret it gives you.
PEACH_WEBHOOK_SECRET=
